<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center"
    android:background="@drawable/bg_widget" android:padding="8dp">
    <ImageView android:id="@+id/wNew" android:layout_width="58dp" android:layout_height="58dp"
        android:src="@drawable/sc_new" android:contentDescription="Yeni sevkiyat" />
    <View android:layout_width="16dp" android:layout_height="1dp" />
    <ImageView android:id="@+id/wVoice" android:layout_width="58dp" android:layout_height="58dp"
        android:src="@drawable/sc_voice" android:contentDescription="Sesli asistanla yeni sevkiyat" />
</LinearLayout>
